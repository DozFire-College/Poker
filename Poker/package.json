{
  "name": "casino-poker",
  "version": "1.0.0",
  "private": true,
  "description": "Техасский холдем против ботов для учебного проекта «Казино»",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "demo": "concurrently -k -n server,client -c blue,magenta \"npm:demo:server\" \"npm:dev:client\"",
    "demo:server": "tsx src/server/index.ts --memory",
    "db:init": "tsx src/server/scripts/db-init.ts",
    "test": "tsx --test tests/evaluator.test.ts tests/engine.test.ts tests/memory-service.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vite": "^7.1.0"
  }
}
