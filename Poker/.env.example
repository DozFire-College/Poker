# Подключение к PostgreSQL: postgres://пользователь:пароль@хост:порт/база
DATABASE_URL=postgres://postgres:postgres@localhost:5432/casino

# Порт Express-сервера (Vite проксирует /api сюда)
PORT=3000

# Учебная авторизация по заголовку X-User-Id. Только для разработки!
# В проекте с настоящим входом поставьте false (см. src/server/auth.ts).
DEV_AUTH=true
